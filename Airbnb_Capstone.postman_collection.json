    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign up for a new account",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/signup",
            "description": "Sign up for a new account",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New User\",\n  \"email\": \"new{{$timestamp}}@example.com\",\n  \"password\": \"Password@123\",\n  \"phone\": \"0901234567\",\n  \"birthday\": \"1995-01-15\",\n  \"gender\": true,\n  \"role\": \"USER\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const result = pm.response.json();",
                  "if (pm.response.code === 200 && result.content?.id) {",
                  "  pm.collectionVariables.set('userId', result.content?.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/signin",
            "description": "Sign in",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"an@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const result = pm.response.json();",
                  "if (pm.response.code === 200 && result.content?.token) {",
                  "  pm.collectionVariables.set('token', result.content?.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
